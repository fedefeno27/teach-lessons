# Copy to .env.local and fill in. Never commit real secrets.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Shared rate limiter (Upstash Redis REST). Optional locally (falls back to
# in-memory); set both in production so limits hold across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
